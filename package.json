{
  "name": "ai-ads-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run standards:build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "standards:build": "tsx scripts/parse-standards.ts",
    "standards:lint": "tsx scripts/doc-lint.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker/index.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "user": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
