# Copy to .env beside docker-compose.yml. Compose reads .env automatically.

# --- Required ---------------------------------------------------------
# Postgres password. No default: an empty database password is not a thing
# this stack will start with.
POSTGRES_PASSWORD=

# Encrypts every provider credential stored in Settings. Without it the app
# refuses to store secrets rather than writing them in plaintext.
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------
POSTGRES_USER=ads
POSTGRES_DB=ai_ads
POSTGRES_PORT=5432
WEB_PORT=3000

# tiny | base | small | medium | large. Larger models transcribe better and
# make the worker image bigger and slower to build.
WHISPER_MODEL=small

# TTS takes synthesised per voice run before ranking. Each one costs credits.
TTS_TAKE_COUNT=3

MAX_UPLOAD_BYTES=536870912

# Provider credentials are normally connected in Settings, not set here.
# These remain as a fallback for a deployment that prefers env.
# ANTHROPIC_API_KEY=
# HIGGSFIELD_MCP_URL=
# HIGGSFIELD_MCP_TOKEN=
# KLING_MCP_URL=
# KLING_MCP_TOKEN=
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=
