# Credentials for the build pipeline. Copy to .env and fill in what you need.
# `npm run ready` tells you which are missing and what each one blocks.

# --- Required for every step -----------------------------------------------
# Every §18 step is a structured model call against a section-sliced view of
# the Standards. Key from console.anthropic.com.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN is accepted in its place.

# --- Required from step 3 onward -------------------------------------------
# Image generation: §19 reference sheets, §30G property plates, §30C scene
# plates. E7 records the call templates in MCP tool terms, so this is an MCP
# endpoint rather than a REST base URL.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# --- Not yet wired (Phase 2) -----------------------------------------------
# The I2V route for beats (steps 6-8 are not built).
KLING_MCP_URL=
KLING_MCP_TOKEN=

# The voice and avatar route. Both adapters are in src/providers/ and both are
# marked UNVERIFIED against live docs — check the request shapes on first run.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# --- Optional --------------------------------------------------------------
# Where builds live. Defaults to ./builds
# BUILDS_ROOT=
