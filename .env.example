# Postgres. The app and pg-boss share one database; pg-boss owns the `pgboss` schema.
DATABASE_URL=postgres://ads:ads@localhost:5432/ai_ads

# Anthropic. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login`
# profile, so this can be left unset where a profile is configured.
ANTHROPIC_API_KEY=

# Where the upload bundle lives. Mirrors the §E9 build directory layout.
# Used only by the filesystem driver — see S3_BUCKET below.
STORAGE_ROOT=./storage

# --- Object storage (optional) ----------------------------------------
# Set S3_BUCKET to switch from the filesystem to object storage. Required
# when the web app and the worker run on different hosts and cannot share a
# volume; unnecessary when they share one. Works with AWS, Cloudflare R2,
# Backblaze B2 and MinIO.
S3_BUCKET=
S3_REGION=auto
# Set for R2 / MinIO / Backblaze; leave empty for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Omit both to use the ambient credential chain (IAM role, ~/.aws).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Whisper model for the Part 4 transcript. tiny | base | small | medium | large
# `small` is the default: fast enough for a 4-minute reference, accurate enough
# for a voice fingerprint.
WHISPER_MODEL=small

# Upload ceiling, bytes. Default 512MB.
MAX_UPLOAD_BYTES=536870912

# --- Secret storage ---------------------------------------------------
# Required before any provider connection can be saved in Settings. Secrets
# are encrypted with AES-256-GCM under this key; the app refuses to store them
# in plaintext if it is missing. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# --- Provider fallbacks -----------------------------------------------
# Connections are normally configured in Settings, which take precedence over
# everything below. These remain supported so local development and CI can run
# with nothing stored.
#
# The Higgsfield MCP endpoint the worker calls for image generation. E7's call
# templates are written in this server's tool terms (generate_image_batch,
# jobs_wait), so the worker speaks MCP rather than reimplementing the REST
# surface. Steps 1 and 2 do not need it.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# Video generation, from step 6.
KLING_MCP_URL=
KLING_MCP_TOKEN=

# Voice route (ElevenLabs + HeyGen). Normally configured in Settings.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# How many TTS takes to synthesise before ranking. Each costs credits.
TTS_TAKE_COUNT=3
